---
import { steps, bilingual } from '../data/learning';
const { compact = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<section class:list={['walk card', {compact}]} data-analysis-steps>
  <div class="eyebrow">財報閱讀路線</div>
  <h2>先讀生意，再算股價</h2>
  <p><b>先問三件事：</b>公司靠什麼賺錢？獲利有變成現金嗎？這個股價需要多好的未來才合理？</p>
  <ol>{steps.map(step => <li><b>{step.title}</b><p>{bilingual(step.text)}</p><small>{step.where}</small></li>)}</ol>
  {compact && <a class="link" href={`${base}learn/`}>跟著迪士尼財報，從原始數字算一次 ↗</a>}
</section>
<style>
.walk{padding:clamp(16px,4vw,30px);margin:20px 0;background:#f4f8ff;border-color:#ccdcee}.walk h2{margin:.35em 0}.walk ol{margin:16px 0;padding-left:1.55rem}.walk li{padding:6px 0 12px 4px}.walk li+li{border-top:1px solid #d9e4f0}.walk li::marker{font-weight:700;color:#205394}.walk p{margin:.25em 0}.walk small{color:#46576d}.compact ol{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));column-gap:28px}.compact li+li{border-top:0}
</style>
