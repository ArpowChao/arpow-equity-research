---
import Base from '../layouts/Base.astro';
import batch from '../data/fundamentals.generated.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const fmt = (v: number | undefined | null) => v == null ? '未取得' : `${(v / 1e8).toLocaleString('zh-TW', { maximumFractionDigits: 2 })} 億美元`;
const period = (field: { start?: string | null, end: string } | null) => field ? `${field.start ? field.start + '～' : ''}${field.end}` : '—';
const items = [...batch.items].sort((a,b)=>a.ticker.localeCompare(b.ticker));
---
<Base title="全站基本面核對｜Arpow 個股研究簿" description="逐檔核對 SEC 原始申報、期間、營收、現金流與現有估值快照的時效。">
  <main class="shell section">
    <div class="eyebrow">SEC evidence check · {batch.checkedAtUtc.slice(0, 10)} UTC</div>
    <h1>全站基本面核對</h1>
    <p class="intro">已逐檔讀取 SEC 申報索引與 XBRL 標準化數據。<strong>這是新證據核對，不是重新估值：</strong>原個股頁的合理價、投資判斷與分析快照仍以其標示日期為準；若近期有新公告，須閱讀全文後才能修訂結論。</p>
    <p class="caution">營收優先採最近申報的單季數值；年度申報或欠缺單季欄位時，明確列出實際起迄期間。營運現金流通常是年初至今累計，不可與單季營收直接相比。多數數值來自 SEC XBRL；LAES 由官方 6-K 附件 99.1 的千美元單位換算。未取得欄位不代表公司沒有該項數值。金額單位為億美元；股價不參與本頁估值。</p>
    <nav class="jump" aria-label="個股快速跳轉">{items.map(i=><a href={`#${i.ticker.toLowerCase()}`}>{i.ticker}</a>)}</nav>
    <div class="cards">
      {items.map(i => <article id={i.ticker.toLowerCase()} class="card stock">
        <header><div><span class="ticker">{i.ticker}</span><h2>{i.company}</h2></div><a href={`${base}research/${i.ticker.toLowerCase()}`}>原研究頁 ↗</a></header>
        <div class="meta"><span>財報期間結束：<b>{i.statement.periodEnd}</b></span><span>SEC 提交：<b>{i.statement.filed} · {i.statement.form}</b></span><span>原估值快照：<b>{i.analysisAsOf}</b></span></div>
        {i.newerFilingNeedsReview && <p class="warning">⚠️ 這份財報之後另有 SEC 文件；以下數值尚未涵蓋新文件可能帶來的變動，請查閱「最新提交文件」。</p>}
        <div class="figures">
          <div><small>營收 · {period(i.fields.revenue)}</small><strong>{fmt(i.fields.revenue?.value)}</strong></div>
          <div><small>GAAP 營業利益 · {period(i.fields.operatingIncome)}</small><strong>{fmt(i.fields.operatingIncome?.value)}</strong></div>
          <div><small>營運現金流 · {period(i.fields.operatingCashFlow)}</small><strong>{fmt(i.fields.operatingCashFlow?.value)}</strong></div>
          <div><small>帳面現金 · {period(i.fields.cash)}</small><strong>{fmt(i.fields.cash?.value)}</strong></div>
        </div>
        <div class="links"><a href={i.statement.url} target="_blank" rel="noopener noreferrer">本次財報原文 ↗</a><a href={i.latestFiling.url} target="_blank" rel="noopener noreferrer">最新 SEC 提交文件 ↗</a></div>
      </article>)}
    </div>
    <p class="foot">資料擷取：{batch.checkedAtUtc}；資料源：SEC submissions／companyfacts。申報書中的分部、指引、調整項目、一次性損益、債務、稀釋與政策風險不一定能由標準 XBRL 欄位反映。不能把此頁當作完成逐檔投資判斷更新。</p>
  </main>
  <style>
    main{padding-top:60px;padding-bottom:80px}h1{font-size:clamp(32px,5vw,54px);margin:8px 0 14px}.intro,.caution,.foot{max-width:950px;line-height:1.75;color:var(--muted)}.intro{font-size:18px}.intro strong{color:var(--text)}.caution{background:#edf4ff;border-left:4px solid var(--blue);padding:15px 20px;border-radius:4px}.jump{display:flex;flex-wrap:wrap;gap:7px;margin:26px 0 34px}.jump a{padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--blue);text-decoration:none;font-weight:700;font-size:13px}.jump a:hover,.jump a:focus-visible{background:var(--blue-soft)}.cards{display:grid;gap:16px}.stock{padding:23px;scroll-margin-top:24px}.stock header{display:flex;align-items:start;justify-content:space-between;gap:20px}.stock header>div{display:flex;align-items:baseline;gap:15px;flex-wrap:wrap}.stock h2{font-size:22px;margin:0}.ticker{color:var(--blue);font-size:24px;font-weight:800}.stock a{color:var(--blue)}.meta{display:flex;gap:10px 20px;flex-wrap:wrap;color:var(--muted);font-size:13px;margin:16px 0}.meta b{color:var(--text)}.warning{border-left:3px solid #ab6725;background:#fff6e6;padding:10px;color:#75460f;font-size:13px}.figures{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.figures>div{border-top:1px solid var(--line);padding-top:12px}.figures small{display:block;color:var(--muted);line-height:1.4;min-height:38px}.figures strong{display:block;margin-top:6px;font-size:19px}.links{display:flex;gap:20px;margin-top:18px;font-size:13px}.foot{font-size:13px;margin-top:30px}@media(max-width:840px){.figures{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.stock{padding:17px}.stock header{display:block}.stock header>a{display:inline-block;margin-top:6px}.figures strong{font-size:16px}.links{flex-wrap:wrap}}
  </style>
</Base>
