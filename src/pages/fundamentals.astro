---
import { bilingual } from "../data/learning";
import AnalysisSteps from '../components/AnalysisSteps.astro';
import Base from '../layouts/Base.astro';
import batch from '../data/fundamentals.generated.json';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const fmt = (v: number | undefined | null) => v == null ? '未取得' : `${(v / 1e8).toLocaleString('zh-TW', { maximumFractionDigits: 2 })} 億美元`;
const period = (field: { start?: string | null, end: string } | null) => field ? `${field.start ? field.start + '～' : ''}${field.end}` : '—';
const checkedAtFor = (i: { ticker: string; checkedAtUtc?: string }) => i.checkedAtUtc ?? batch.checkedAtUtc;
const pct = (v: number) => `${v >= 0 ? '+' : ''}${v.toFixed(1)}%`;
const items = [...batch.items].sort((a,b)=>a.ticker.localeCompare(b.ticker));
---
<Base title="全站基本面核對｜Arpow 個股研究簿" description="逐檔核對 SEC 原始申報、期間、營收、現金流與現有估值快照的時效。">
  <main class="shell section">
    <div class="eyebrow">SEC evidence check · 各檔核對日期見卡片</div>
    <h1>全站基本面核對</h1>
  <AnalysisSteps compact />
    <p class="intro">截至 {batch.checkedAtUtc.slice(0,10)} UTC 已逐檔核對 {items.length} 檔的 SEC 申報索引及財報數據。<strong>基本面更新不等於重新估值：</strong>各檔保留原估值快照；後續公告若只核對索引，不視為已納入模型。</p>
    <p class="caution">10-Q 營收採單季口徑，10-K 採全年口徑，其他依實際申報起迄日。簡式自由現金流只用同期間的營運現金流減資本支出，不含租賃本金等其他調整。營運現金流通常是年初至今累計，不可與單季營收直接相比。多數數值來自 SEC XBRL；LAES 由官方 6-K 附件 99.1 的千美元單位換算。未取得欄位不代表公司沒有該項數值。金額單位為億美元；股價不參與本頁估值。</p>
    <nav class="jump" aria-label="個股快速跳轉">{items.map(i=><a href={`#${i.ticker.toLowerCase()}`}>{i.ticker}</a>)}</nav>
    <div class="cards">
      {items.map(i => <article id={i.ticker.toLowerCase()} class="card stock">
        <header><div><span class="ticker">{i.ticker}</span><h2>{i.company}</h2></div><a href={`${base}research/${i.ticker.toLowerCase()}`}>原研究頁 ↗</a></header>
        <div class="meta"><span>本檔核對：<b>{checkedAtFor(i).slice(0,10)} UTC</b></span><span>財報期間結束：<b>{i.statement.periodEnd}</b></span><span>SEC 提交：<b>{i.statement.filed} · {i.statement.form}</b></span><span>原估值快照：<b>{i.analysisAsOf}</b></span></div>
        {i.analysisAsOf < i.statement.filed && <p class="warning">這份財報晚於估值快照，舊模型尚未納入這份申報。</p>}
        {i.newerFilingNeedsReview && <p class="warning">申報索引另有後續公司文件；下列財報數字未納入新文件可能帶來的變動。</p>}
        {i.preliminary && <p class="warning"><strong>較新初值：</strong>{i.preliminary.text} <a href={i.preliminary.url}>SEC 公告附件 ↗</a></p>}
        <div class="figures">
          <div><small>{bilingual("營收")} · {period(i.fields.revenue)}</small><strong>{fmt(i.fields.revenue?.value)}</strong>{i.revenueYoyPct != null && <small>{bilingual("年增率")}：{pct(i.revenueYoyPct)}</small>}</div>
          <div><small>{i.ticker === "DIS" ? bilingual("分部營業利益合計") + "（非 GAAP）" : "Operating Income (Loss)（申報營業損益；依原表口徑）"} · {period(i.fields.operatingIncome)}</small><strong>{fmt(i.fields.operatingIncome?.value)}</strong></div>
          <div><small>{bilingual("營運現金流")} · {period(i.fields.operatingCashFlow)}</small><strong>{fmt(i.fields.operatingCashFlow?.value)}</strong></div>
          <div><small>{bilingual("帳面現金")} · {period(i.fields.cash)}</small><strong>{fmt(i.fields.cash?.value)}</strong></div>
          <div><small>{bilingual("資本支出")} · {period(i.fields.capitalExpenditure)}</small><strong>{fmt(i.fields.capitalExpenditure?.value)}</strong></div>
          <div><small>{bilingual("簡式自由現金流")} · {period(i.simpleFcf)}</small><strong>{fmt(i.simpleFcf?.value)}</strong></div>
        </div>
        <p class="foot">資料口徑：{i.sourceMethod}</p>
        <div class="links"><a href={i.statement.url} target="_blank" rel="noopener noreferrer">本次財報原文 ↗</a><a href={i.latestFiling.url} target="_blank" rel="noopener noreferrer">索引最新公司申報 · {i.latestFiling.form} ↗</a></div>
      </article>)}
    </div>
    <p class="foot">原批次資料擷取：{batch.checkedAtUtc}；個別更新時間見卡片。資料源：SEC submissions／companyfacts；APP 與 LULU 部分缺少標準標記的數值採用既有同份財報原文數值；NVDA 採當季 8-K 附件，LAES 另列九個月公告初值。申報書中的分部、指引、調整項目、一次性損益、債務、稀釋與政策風險不一定能由標準 XBRL 欄位反映。不能把此頁當作完成逐檔投資判斷更新。</p>
  </main>
  <style>
    main{padding-top:60px;padding-bottom:80px}h1{font-size:clamp(32px,5vw,54px);margin:8px 0 14px}.intro,.caution,.foot{max-width:950px;line-height:1.75;color:var(--muted)}.intro{font-size:18px}.intro strong{color:var(--text)}.caution{background:#edf4ff;border-left:4px solid var(--blue);padding:15px 20px;border-radius:4px}.jump{display:flex;flex-wrap:wrap;gap:7px;margin:26px 0 34px}.jump a{padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--blue);text-decoration:none;font-weight:700;font-size:13px}.jump a:hover,.jump a:focus-visible{background:var(--blue-soft)}.cards{display:grid;gap:16px}.stock{padding:23px;scroll-margin-top:24px}.stock header{display:flex;align-items:start;justify-content:space-between;gap:20px}.stock header>div{display:flex;align-items:baseline;gap:15px;flex-wrap:wrap}.stock h2{font-size:22px;margin:0}.ticker{color:var(--blue);font-size:24px;font-weight:800}.stock a{color:var(--blue)}.meta{display:flex;gap:10px 20px;flex-wrap:wrap;color:var(--muted);font-size:13px;margin:16px 0}.meta b{color:var(--text)}.warning{border-left:3px solid #ab6725;background:#fff6e6;padding:10px;color:#75460f;font-size:13px}.figures{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.figures>div{border-top:1px solid var(--line);padding-top:12px}.figures small{display:block;color:var(--muted);line-height:1.4;min-height:38px}.figures strong{display:block;margin-top:6px;font-size:19px}.links{display:flex;gap:20px;margin-top:18px;font-size:13px}.foot{font-size:13px;margin-top:30px}@media(max-width:840px){.figures{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.stock{padding:17px}.stock header{display:block}.stock header>a{display:inline-block;margin-top:6px}.figures strong{font-size:16px}.links{flex-wrap:wrap}}
  </style>
</Base>
