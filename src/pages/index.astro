---
import Signal from "../components/Signal.astro";
import Base from '../layouts/Base.astro';
import reports from '../data/reports.generated.json';
import FilingEvidence from "../components/FilingEvidence.astro";
import BaseWork from "../components/BaseWork.astro";
import { activeModel, money, naturalProse, gapLabel, gapFormula, snapshotGap } from '../data/learning';
import { pinnedTickers, resolveReportViewModel } from '../lib/report-resolver';
import AnalysisSteps from '../components/AnalysisSteps.astro';
import { methods } from '../data/methods';

const priority = (t: string) => {
  const idx = pinnedTickers.indexOf(t);
  return idx >= 0 ? idx : pinnedTickers.length;
};
const sorted = [...reports].sort((a, b) => priority(a.ticker) - priority(b.ticker) || b.asOf.localeCompare(a.asOf));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Base title="Arpow 個股研究簿">
  <section class="shell hero">
    <div>
      <div class="eyebrow">證據 → 試算 → 買方判斷</div>
      <h1>把每一次分析，<br><span>變成可追溯的研究資產。</span></h1>
      <p>從 SEC 原始財報出發，結合故事線 Setup、分部加減帳、現價逆推定價與含 4 年 FCF 雙殺壓測，所有算式與假設完全公開。</p>
      <p><a class="link" href={`${base}learn/`}>新手從這裡開始：用一份財報練習 ↗</a>　<a class="link" href="#stock-cards">直接看首頁卡片 ↓</a>　<a class="link" href={`${base}methodology/buyside-v2-playbook`}>v2 買方五模組標準 ↗</a></p>
    </div>
    <aside class="hero-ledger card" aria-label="研究流程">
      <div class="ledger-row"><span>01</span><b>故事線與證據</b><small>Setup 擁擠度／SEC／IR</small></div>
      <div class="ledger-row"><span>02</span><b>含權計算底稿</b><small>逆推定價 × 含 FCF 2D 壓測</small></div>
      <div class="ledger-row"><span>03</span><b>可證偽結論</b><small>同業錨點與加減碼門檻</small></div>
    </aside>
  </section>

  <section class="shell section" id="stock-cards">
    <div class="section-head"><div><div class="eyebrow">不必先點進個股頁</div><h2>個股卡片｜先看數字，再看怎麼算</h2></div><p>每張卡直接列基準計算。行情以實際成交時間為準；估值按標示版本固定。{gapLabel}＝{gapFormula}。綠色表示基準高於快照股價，紅色表示低於；符號：× 乘、÷ 除、＋ 加、− 減、＝ 等於、≈ 約等於；$ 表示美元。</p></div>
    <div class="reports grid" data-live-grid data-endpoint={`${base}data/live-quotes.json`}>
      {sorted.map((r) => {
        const vm = resolveReportViewModel(r);
        const comparison = snapshotGap(vm.activeModel?.cases[1]?.value ?? r.snapshot.baseFairValue, vm.activeModel?.price ?? r.snapshot.price);
        return <a class="report card" id={`card-${r.ticker.toLowerCase()}`} href={`${base}research/${r.ticker.toLowerCase()}/`} data-live-card data-min-observed-at={(r.priceMeta as {observedAtUtc?:string}|undefined)?.observedAtUtc} data-ticker={r.ticker} data-pre-split={vm.preSplit ? "true" : undefined} data-older-model={vm.historic ? "true" : undefined}>
          <div class="report-top">
            <span class="ticker mono">{r.ticker}</span>
            <span class="top-pills">
              {vm.buysideV2 && <span class="pill v2-pill">v2 買方｜{vm.buysideV2.verdict.tier}</span>}
              <span class="pill">{vm.cardPillLabel}</span>
            </span>
          </div>
          <h3>{r.ticker === "DIS" ? "迪士尼" : r.ticker === "IONQ" ? "IonQ｜量子運算" : r.company}</h3>
          <FilingEvidence ticker={r.ticker} compact />
          {!vm.historic && <p><b>{r.asOf} 研究摘要：</b>{naturalProse(vm.buysideV2 ? vm.buysideV2.verdict.oneLiner : r.thesis)}</p>}
          <div class="report-numbers">
            <div class="live-cell"><small>最近可得行情 <b data-card-status>讀取中</b></small><strong data-card-live-price>—</strong><small data-card-quote-time></small><em data-card-live-gap>正在取得行情…</em></div>
            {vm.activeModel ? <><div><small>正規盤快照</small><strong>{money(vm.activeModel.price)}</strong><em>{vm.activeModel.date}</em></div><div data-active-model={r.ticker}><small>條件基準</small><strong>{money(vm.activeModel.cases[1]!.value)}</strong><em>美元／股 · 非即時</em></div></> : <>
            <div><small>分析快照</small><strong>${r.snapshot.price.toFixed(2)}</strong><em>{vm.snapshotDateLabel}</em></div>
            <div><small>{vm.cardBaseLabel}</small><strong>${r.snapshot.baseFairValue.toFixed(2)}</strong><em>美元／股 · 非即時</em></div>
            </>}
          </div>
          <p class="card-gap" data-snapshot-gap>{gapLabel} <Signal value={comparison} kind="gap" /></p>
          {vm.activeModel && <div class="card-cases" aria-label="情境估值，美元每股">{vm.activeModel.cases.map(c=><span>{c.label} <b>{money(c.value)}</b></span>)}{vm.activeModel.stress!=null && <span>壓力 <b>{money(vm.activeModel.stress)}</b></span>}</div>}
          <BaseWork ticker={r.ticker} legacy={r} />
          <span class="open">{vm.activeModel ? "開啟三情境、計算步驟與原研究 →" : vm.olderModel ? "有較新申報，估值仍為舊快照 →" : "開啟完整研究 →"}</span>
        </a>
      })}
      {(() => {
        const zs = activeModel('ZS')!;
        return <a class="report card" data-active-model="ZS" data-zs-live-card data-ticker="ZS" href={`${base}research/zs/`}>
          <div class="report-top"><span class="ticker mono">ZS</span><span class="pill">{zs.label} · {zs.date}</span></div>
          <h3>Zscaler｜雲端資安</h3><p>以訂閱方式提供雲端安全服務；情境要驗證成長、收現與股權薪酬稀釋。</p>
          <div class="report-numbers">
            <div class="live-cell"><small>最近可得行情 <b data-card-status>讀取中</b></small><strong data-card-live-price>—</strong><small data-card-quote-time></small><em data-card-live-gap>正在取得行情…</em></div>
            <div><small>正規盤快照</small><strong>{money(zs.price)}</strong><em>{zs.date}</em></div>
            <div><small>條件基準</small><strong>{money(zs.cases[1]!.value)}</strong><em>美元／股 · 非即時</em></div>
          </div>
          <div class="card-cases" aria-label="情境估值，美元每股">{zs.cases.map(c=><span>{c.label} <b>{money(c.value)}</b></span>)}</div>
          <p class="card-gap" data-snapshot-gap>{gapLabel} <Signal value={snapshotGap(zs.cases[1]!.value,zs.price)} kind="gap" /></p>
          <BaseWork ticker="ZS" /><span class="open">開啟三情境、輸入來源與風險 →</span>
        </a>;
      })()}
    </div>
  </section>
  <section class="shell section" aria-label="進階閱讀">
    <p style="background:#edf4ff;border-left:4px solid #2762be;padding:14px 20px;line-height:1.65"><strong>基本面新證據已核對：</strong>全站個股的最新 SEC 申報與標準化財務欄位，請看 <a href={`${base}fundamentals/`}>全站基本面核對 ↗</a>。原研究估值仍屬各自標示日期的快照，未因新行情自動重算。</p>
    <p class="card" style="padding:18px 22px"><strong>新產業觀察｜資安與AI安全：</strong><a class="link" href={`${base}sectors/cybersecurity-2026-11-01/`}>大、中、小盤候選與併購排除名單 ↗</a>。2026-11-01產業初篩，非合理價或買入清單。</p>
    <p class="card" style="padding:18px 22px"><strong>11/14六股雙軌研究：</strong><a class="link" href={`${base}comparisons/six-2026-11-14/`}>MU／FISV／AMD／NVDA／MSFT／AMZN：正常成長與價值股壓力比較 ↗</a>。統一11/13正規盤收盤；遠期價值與今日現值分開。</p>
    <p class="card" style="padding:18px 22px"><strong>11/22 新財報重估：</strong><a class="link" href={`${base}comparisons/revaluation-2026-11-22/`}>看各檔最新三情境與舊基準差異 ↗</a></p>
    <p class="card" style="padding:18px 22px"><strong>14 檔條件估值：</strong><a class="link" href={`${base}comparisons/selection-14/`}>三情境、壓力測試與財報重點 ↗</a></p>
    <AnalysisSteps compact />
  </section>

  <script>
    const grid = document.querySelector<HTMLElement>('[data-live-grid]');
    const phaseLabels: Record<string,string> = {'pre-market':'盤前','regular':'正規盤','post-market':'盤後','closed':'收盤'};
    async function refreshArchiveQuotes(){
      if(!grid?.dataset.endpoint) return;
      const cards = document.querySelectorAll<HTMLElement>('[data-live-card], [data-zs-live-card]');
      try{
        const response = await fetch(`${grid.dataset.endpoint}?v=${Date.now()}`, {cache:'no-store'});
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        cards.forEach(card=>{
          const quote = payload?.quotes?.[card.dataset.ticker || ''];
          const priceNode = card.querySelector<HTMLElement>('[data-card-live-price]');
          const statusNode = card.querySelector<HTMLElement>('[data-card-status]');
          const timeNode = card.querySelector<HTMLElement>('[data-card-quote-time]');
          const gapNode = card.querySelector<HTMLElement>('[data-card-live-gap]');
          if(!quote || !priceNode || !statusNode || !gapNode || !Number.isFinite(Number(quote.price))) {
            if(statusNode) statusNode.textContent = '待下次排程同步';
            return;
          }
          const minimum=Date.parse(card.dataset.minObservedAt||'');
          const observedAt=Date.parse(quote.observedAt||'');
          if(!Number.isFinite(observedAt)||(Number.isFinite(minimum)&&observedAt<minimum)){statusNode.textContent='暫無較新行情';priceNode.textContent='—';gapNode.textContent='行情檔早於分析快照';card.dataset.liveState='stale';return;}
          const price = Number(quote.price);
          priceNode.textContent = `$${price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
          statusNode.textContent = phaseLabels[quote.phase] ?? '快照';
          if(timeNode) timeNode.textContent = `${new Intl.DateTimeFormat('sv-SE',{timeZone:'America/New_York',dateStyle:'short',timeStyle:'short'}).format(observedAt)} 美東`;
          if(card.dataset.preSplit === 'true'){
            gapNode.textContent = '拆股後行情 · 不直接比較舊估值';
            card.dataset.liveState = 'ready';
            return;
          }
          if(card.dataset.olderModel === 'true'){
            gapNode.textContent = '行情與估值快照分開 · 不直接比較';
            card.dataset.liveState = 'ready';
            return;
          }
          gapNode.textContent = '基準差距使用研究快照，不混用近期行情';
          card.dataset.liveState = 'ready';
        });
      }catch(error){
        cards.forEach(card=>{
          const statusNode = card.querySelector<HTMLElement>('[data-card-status]');
          const gapNode = card.querySelector<HTMLElement>('[data-card-live-gap]');
          if(statusNode) statusNode.textContent = '暫無資料';
          if(gapNode) gapNode.textContent = '請看分析快照';
          card.dataset.liveState = 'error';
        });
      }
    }
    refreshArchiveQuotes();
    window.setInterval(refreshArchiveQuotes,60_000);
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')refreshArchiveQuotes();});
  </script>

  <section id="methods" class="method-wrap">
    <div class="shell section">
      <div class="section-head"><div><div class="eyebrow">公開計算方法</div><h2>計算不是黑盒子</h2></div><p>報告中的專業計算都連到獨立方法頁；公式、適用條件和模型限制一起公開。</p></div>
      <div class="methods grid">{methods.map((m, i) => <a class="method" href={`${base}methodology/${m.slug}`}><span class="mono">M{String(i+1).padStart(2,'0')}</span><div><h3>{m.title}</h3><p>{m.summary}</p></div><b>↗</b></a>)}</div>
    </div>
  </section>
  <style>
    .hero{padding-top:78px;padding-bottom:58px;display:grid;grid-template-columns:1.35fr .65fr;align-items:end;gap:70px}.hero h1 span{color:var(--blue)}.hero p{max-width:650px;font-size:19px;color:var(--muted)}.hero-ledger{padding:12px 20px}.ledger-row{display:grid;grid-template-columns:34px 1fr;gap:2px 10px;padding:17px 0;border-bottom:1px solid var(--line)}.ledger-row:last-child{border:0}.ledger-row span{grid-row:1/3;color:var(--blue);font:600 12px 'IBM Plex Mono'}.ledger-row small{color:var(--muted)}.reports{grid-template-columns:repeat(2,1fr)}.report{padding:24px;text-decoration:none;transition:.2s transform,.2s box-shadow}.report:hover{transform:translateY(-3px);box-shadow:0 20px 45px rgba(20,32,43,.11)}.report-top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}.top-pills{display:flex;gap:6px;flex-wrap:wrap;justify-content:end}.v2-pill{background:#0b6949;color:#fff}.ticker{font-size:27px;font-weight:600}.report h3{font-size:23px;margin:18px 0 8px}.report p{color:var(--muted);min-height:76px}.report-numbers{display:grid;grid-template-columns:repeat(3,1fr);padding:17px 0;margin:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.report-numbers div+div{border-left:1px solid var(--line);padding-left:16px}.report-numbers small{display:block;color:var(--muted);font-size:11px}.report-numbers strong{display:block;font:600 18px 'IBM Plex Mono';margin-top:5px}.report-numbers em{display:block;margin-top:3px;color:var(--muted);font:500 10px 'IBM Plex Mono';font-style:normal}.report .card-gap{min-height:0;margin:8px 0;color:#254e88}.card-cases{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:.87rem}.card-cases b{white-space:nowrap}.report{min-width:0}.report-numbers .live-cell strong{color:var(--blue)}[data-card-status]{margin-left:4px;padding:2px 5px;border-radius:999px;background:var(--blue-soft);color:var(--blue);font:600 9px 'IBM Plex Mono'}.report[data-live-state='error'] .live-cell strong{color:var(--muted)}.open{color:var(--blue);font-weight:600;font-size:14px}.method-wrap{background:#101b2a;color:#edf4ff;margin-top:30px}.method-wrap .section-head p{color:#9fb0c5}.methods{grid-template-columns:repeat(2,1fr)}.method{display:grid;grid-template-columns:42px 1fr 20px;gap:14px;text-decoration:none;border-top:1px solid #2a3a4d;padding:24px 4px}.method>span,.method>b{color:#6ea2ff}.method h3{margin:0 0 6px}.method p{margin:0;color:#9fb0c5}@media(max-width:800px){.hero{grid-template-columns:1fr;gap:28px;padding-top:48px}.reports,.methods{grid-template-columns:1fr}.report p{min-height:auto}}@media(max-width:480px){.report-numbers{grid-template-columns:1fr}.report-numbers div+div{border-left:0;border-top:1px solid var(--line);padding:10px 0 0;margin-top:10px}}
  </style>
</Base>
