---
import Base from '../layouts/Base.astro';
import reports from '../data/reports.generated.json';
import { methods } from '../data/methods';
const sorted = [...reports].sort((a,b) => b.asOf.localeCompare(a.asOf));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Base title="Arpow 個股研究簿">
  <section class="shell hero">
    <div>
      <div class="eyebrow">Evidence → Model → Decision</div>
      <h1>把每一次分析，<br><span>變成可追溯的研究資產。</span></h1>
      <p>不是把聊天複製成文章。每一個合理價、股數與現金流，都能回到公式、假設和原始來源。</p>
    </div>
    <aside class="hero-ledger card" aria-label="研究流程">
      <div class="ledger-row"><span>01</span><b>原始證據</b><small>SEC／公司 IR／行情快照</small></div>
      <div class="ledger-row"><span>02</span><b>計算底稿</b><small>正常化、稀釋、情境敏感度</small></div>
      <div class="ledger-row"><span>03</span><b>公開結論</b><small>驗證條件、風險與版本差異</small></div>
    </aside>
  </section>

  <section class="shell section">
    <div class="section-head"><div><div class="eyebrow">Research archive</div><h2>最新個股研究</h2></div><p>最新行情約每15分鐘更新；分析快照與合理價固定保存，不會隨行情自動改寫。</p></div>
    <div class="reports grid" data-live-grid data-endpoint={`${base}data/live-quotes.json`}>
      {sorted.map((r) => {
        const upside = ((r.snapshot.baseFairValue / r.snapshot.price - 1) * 100);
        return <a class="report card" href={`${base}research/${r.ticker.toLowerCase()}`} data-live-card data-ticker={r.ticker} data-fair-value={r.snapshot.baseFairValue}>
          <div class="report-top"><span class="ticker mono">{r.ticker}</span><span class="pill">{r.status === 'current' ? '最新研究' : '封存快照'} · {r.asOf}</span></div>
          <h3>{r.company}</h3><p>{r.thesis}</p>
          <div class="report-numbers">
            <div class="live-cell"><small>最新行情 <b data-card-status>讀取中</b></small><strong data-card-live-price>—</strong><em data-card-live-gap>正在取得行情…</em></div>
            <div><small>分析快照</small><strong>${r.snapshot.price.toFixed(2)}</strong><em>{r.asOf}</em></div>
            <div><small>基準合理價</small><strong>${r.snapshot.baseFairValue.toFixed(2)}</strong><em class={upside >= 0 ? 'positive':'negative'}>快照差距 {upside >= 0 ? '+':''}{upside.toFixed(1)}%</em></div>
          </div>
          <span class="open">開啟完整研究 →</span>
        </a>
      })}
    </div>
  </section>

  <script>
    const grid = document.querySelector<HTMLElement>('[data-live-grid]');
    const phaseLabels: Record<string,string> = {'pre-market':'盤前','regular':'正規盤','post-market':'盤後','closed':'收盤'};
    async function refreshArchiveQuotes(){
      if(!grid?.dataset.endpoint) return;
      try{
        const response = await fetch(`${grid.dataset.endpoint}?v=${Date.now()}`, {cache:'no-store'});
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        document.querySelectorAll<HTMLElement>('[data-live-card]').forEach(card=>{
          const quote = payload?.quotes?.[card.dataset.ticker || ''];
          const priceNode = card.querySelector<HTMLElement>('[data-card-live-price]');
          const statusNode = card.querySelector<HTMLElement>('[data-card-status]');
          const gapNode = card.querySelector<HTMLElement>('[data-card-live-gap]');
          const fair = Number(card.dataset.fairValue);
          if(!quote || !priceNode || !statusNode || !gapNode || !Number.isFinite(Number(quote.price)) || !fair) return;
          const price = Number(quote.price);
          const gap = (fair/price-1)*100;
          priceNode.textContent = `$${price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
          statusNode.textContent = phaseLabels[quote.phase] ?? '最新';
          gapNode.textContent = `距基準 ${gap>=0?'+':''}${gap.toFixed(1)}%`;
          gapNode.classList.remove('positive','negative');
          gapNode.classList.add(gap>=0?'positive':'negative');
          card.dataset.liveState = 'ready';
        });
      }catch(error){
        document.querySelectorAll<HTMLElement>('[data-live-card]').forEach(card=>{
          const statusNode = card.querySelector<HTMLElement>('[data-card-status]');
          const gapNode = card.querySelector<HTMLElement>('[data-card-live-gap]');
          if(statusNode) statusNode.textContent = '暫無資料';
          if(gapNode) gapNode.textContent = '請看分析快照';
          card.dataset.liveState = 'error';
        });
      }
    }
    refreshArchiveQuotes();
    window.setInterval(refreshArchiveQuotes,60_000);
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')refreshArchiveQuotes();});
  </script>

  <section id="methods" class="method-wrap">
    <div class="shell section">
      <div class="section-head"><div><div class="eyebrow">Open methodology</div><h2>計算不是黑盒子</h2></div><p>報告中的專業計算都連到獨立方法頁；公式、適用條件和模型限制一起公開。</p></div>
      <div class="methods grid">{methods.map((m, i) => <a class="method" href={`${base}methodology/${m.slug}`}><span class="mono">M{String(i+1).padStart(2,'0')}</span><div><h3>{m.title}</h3><p>{m.summary}</p></div><b>↗</b></a>)}</div>
    </div>
  </section>
  <style>
    .hero{padding-top:78px;padding-bottom:58px;display:grid;grid-template-columns:1.35fr .65fr;align-items:end;gap:70px}.hero h1 span{color:var(--blue)}.hero p{max-width:650px;font-size:19px;color:var(--muted)}.hero-ledger{padding:12px 20px}.ledger-row{display:grid;grid-template-columns:34px 1fr;gap:2px 10px;padding:17px 0;border-bottom:1px solid var(--line)}.ledger-row:last-child{border:0}.ledger-row span{grid-row:1/3;color:var(--blue);font:600 12px 'IBM Plex Mono'}.ledger-row small{color:var(--muted)}.reports{grid-template-columns:repeat(2,1fr)}.report{padding:24px;text-decoration:none;transition:.2s transform,.2s box-shadow}.report:hover{transform:translateY(-3px);box-shadow:0 20px 45px rgba(20,32,43,.11)}.report-top{display:flex;justify-content:space-between;align-items:center}.ticker{font-size:27px;font-weight:600}.report h3{font-size:23px;margin:18px 0 8px}.report p{color:var(--muted);min-height:76px}.report-numbers{display:grid;grid-template-columns:repeat(3,1fr);padding:17px 0;margin:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.report-numbers div+div{border-left:1px solid var(--line);padding-left:16px}.report-numbers small{display:block;color:var(--muted);font-size:11px}.report-numbers strong{display:block;font:600 18px 'IBM Plex Mono';margin-top:5px}.report-numbers em{display:block;margin-top:3px;color:var(--muted);font:500 10px 'IBM Plex Mono';font-style:normal}.report-numbers .live-cell strong{color:var(--blue)}[data-card-status]{margin-left:4px;padding:2px 5px;border-radius:999px;background:var(--blue-soft);color:var(--blue);font:600 9px 'IBM Plex Mono'}.report[data-live-state='error'] .live-cell strong{color:var(--muted)}.open{color:var(--blue);font-weight:600;font-size:14px}.method-wrap{background:#101b2a;color:#edf4ff;margin-top:30px}.method-wrap .section-head p{color:#9fb0c5}.methods{grid-template-columns:repeat(2,1fr)}.method{display:grid;grid-template-columns:42px 1fr 20px;gap:14px;text-decoration:none;border-top:1px solid #2a3a4d;padding:24px 4px}.method>span,.method>b{color:#6ea2ff}.method h3{margin:0 0 6px}.method p{margin:0;color:#9fb0c5}@media(max-width:800px){.hero{grid-template-columns:1fr;gap:28px;padding-top:48px}.reports,.methods{grid-template-columns:1fr}.report p{min-height:auto}}@media(max-width:480px){.report-numbers{grid-template-columns:1fr}.report-numbers div+div{border-left:0;border-top:1px solid var(--line);padding:10px 0 0;margin-top:10px}}
  </style>
</Base>
