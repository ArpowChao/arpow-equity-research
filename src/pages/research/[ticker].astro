---
import Base from '../../layouts/Base.astro';
import reports from '../../data/reports.generated.json';
import { beginnerGuides, glossary } from '../../data/beginner-guides';
export function getStaticPaths(){ return reports.map(report => ({params:{ticker:report.ticker.toLowerCase()},props:{report}})); }
type Scenario = { label: string; assumption: string; value: number; condition: string };
type AnalysisBlock = { kicker: string; title: string; body: string };
type ExtendedReport = Omit<(typeof reports)[number], 'valuation'> & {
  valuation: any;
  priceMeta?: { marketState: string; asOf: string; source: string };
  scenarios?: Scenario[];
  analysis?: AnalysisBlock[];
  modelNotes?: string;
};
const report = Astro.props.report as ExtendedReport;
const upside = ((report.snapshot.baseFairValue/report.snapshot.price)-1)*100;
const methodFor = report.valuation.type === 'ev-sales-diluted' ? 'dilution-rpo' : report.valuation.type === 'future-ev-ebitda' ? 'project-ramp-valuation' : report.valuation.type === 'cycle-pe' ? 'memory-cycle' : 'scenario-valuation';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const chartUrl = `${base}${report.chart.replace(/^\//, '')}`;
const priceMeta = report.priceMeta;
const scenarios = report.scenarios ?? [];
const analysis = report.analysis ?? [];
const guide = beginnerGuides[report.ticker];
const [mosLow, mosHigh] = report.snapshot.marginOfSafety;
const priceVerdict = report.snapshot.price <= mosHigh
  ? `目前價格已進入本模型的安全邊際區（$${mosLow}–$${mosHigh}），但仍要確認基本面沒有惡化。`
  : report.snapshot.price < report.snapshot.baseFairValue
    ? `目前價格低於基準合理價，但還沒進入安全邊際區；便宜一些，不等於風險已經很低。`
    : report.snapshot.price <= report.snapshot.bull
      ? `目前價格高於基準合理價，市場已預先相信不少好消息，接下來更怕成長不如預期。`
      : `目前價格已高於本模型樂觀情境，市場要求多項好事同時發生，容錯空間很小。`;
---
<Base title={`${report.ticker}｜${report.company} 個股研究`} description={report.thesis}>
  <section class="shell report-hero">
    <div><div class="eyebrow">{report.ticker} · {report.asOf} 快照</div><h1>{report.company}</h1><p>{report.thesis}</p></div>
    <div class="quote card"><span>{priceMeta?.marketState === 'pre-market' ? '盤前價格快照' : '分析日價格'}</span><strong>${report.snapshot.price.toFixed(2)}</strong><small>基準合理價 ${report.snapshot.baseFairValue.toFixed(2)} · <b class={upside>=0?'positive':'negative'}>{upside>=0?'+':''}{upside.toFixed(1)}%</b></small>{priceMeta && <small>{priceMeta.asOf} · {priceMeta.source}</small>}</div>
  </section>

  <section class="shell scenario-strip">
    <div class="scenario bear"><span>悲觀</span><strong>${report.snapshot.bear.toFixed(2)}</strong></div>
    <div class="scenario base"><span>基準</span><strong>${report.snapshot.base.toFixed(2)}</strong></div>
    <div class="scenario bull"><span>樂觀</span><strong>${report.snapshot.bull.toFixed(2)}</strong></div>
    <div class="ranges"><div><span>一般合理區間</span><b>${report.snapshot.fairRange[0]}–${report.snapshot.fairRange[1]}</b></div><div><span>安全邊際區</span><b>${report.snapshot.marginOfSafety[0]}–${report.snapshot.marginOfSafety[1]}</b></div></div>
  </section>

  {guide && <section class="shell beginner-section" aria-labelledby="beginner-title">
    <div class="beginner-head">
      <div><div class="eyebrow">Start here</div><h2 id="beginner-title">第一次看這家公司，先看這裡</h2></div>
      <span class="industry-tag">{guide.industry}</span>
    </div>
    <div class="beginner-steps">
      <article><span class="step-label">它怎麼賺錢？</span><p>{guide.earns}</p></article>
      <article><span class="step-label">現在真正要問什麼？</span><p>{guide.keyQuestion}</p></article>
      <article class="price-step"><span class="step-label">價格怎麼看？</span><p>{priceVerdict}</p></article>
    </div>
    <div class="watch-head"><div><span>不同產業，看不同數字</span><h3>這家公司最該追蹤的業務引擎</h3></div><p>不用一次看懂所有財報。先盯這幾項，確認它們是在變好，還是變壞。</p></div>
    <div class="watch-grid">{guide.watch.map(item=><article class="watch-card">
      <h3>{item.name}</h3><p>{item.why}</p>
      <div class="signal good"><b>變好看這個</b><span>{item.good}</span></div>
      <div class="signal bad"><b>警訊看這個</b><span>{item.warning}</span></div>
    </article>)}</div>
    <details class="glossary card"><summary>看不懂 GAAP、FCF、RPO？點開白話名詞表</summary><dl>{guide.terms.map(term=><div><dt>{term}</dt><dd>{glossary[term]}</dd></div>)}</dl></details>
  </section>}

  <section class="shell content-grid section">
    <article>
      <div class="section-head"><div><div class="eyebrow">Operating evidence</div><h2>關鍵營運證據</h2></div></div>
      <div class="metric-grid grid">{report.metrics.map(m=><div class="metric-card card"><span>{m.label}</span><strong>{m.value}</strong><small>{m.note}</small></div>)}</div>
      <div class="chart card"><img src={chartUrl} alt={`${report.ticker} 於 ${report.asOf} 的一年價格結構圖`} loading="lazy" /></div>
      {scenarios.length > 0 && <div class="scenario-table card"><h2>情境假設與驗證條件</h2><div class="table-scroll"><table><thead><tr><th>情境</th><th>核心輸入</th><th>合理價</th><th>可觀察條件</th></tr></thead><tbody>{scenarios.map(s=><tr><td><b>{s.label}</b></td><td>{s.assumption}</td><td class="mono">${Number(s.value).toFixed(2)}</td><td>{s.condition}</td></tr>)}</tbody></table></div></div>}
      {analysis.length > 0 && <div class="analysis-list">{analysis.map(a=><section class="analysis-card card"><div class="eyebrow">{a.kicker}</div><h2>{a.title}</h2><p>{a.body}</p></section>)}</div>}
      <div class="split grid"><div><h2>價值驅動因子</h2><ul>{report.drivers.map(x=><li>{x}</li>)}</ul></div><div><h2>主要風險</h2><ul>{report.risks.map(x=><li>{x}</li>)}</ul></div></div>
    </article>
    <aside>
      <div class="calc card">
        <div class="eyebrow">Model explorer</div><h2>估值試算</h2>
        {report.valuation.type === 'future-ev-ebitda' ? <div data-calculator="future-ebitda"><label>遠期 EBITDA（百萬）<input id="ebitda" type="number" step="10" value={report.valuation.forwardEbitda}/></label><label>EV/EBITDA<input id="multiple" type="number" step="0.5" value={report.valuation.baseMultiple}/></label><label>遠期淨現金（百萬；淨負債填負值）<input id="cash" type="number" step="10" value={report.valuation.netCash}/></label><label>折現因子<input id="discount" type="number" step="0.01" value={report.valuation.discountFactor}/></label><label>未來稀釋股數（百萬）<input id="shares" type="number" step="1" value={report.valuation.dilutedShares}/></label><div class="result"><span>試算現值</span><strong id="result">—</strong></div></div> : report.valuation.type !== 'ev-sales-diluted' ? <div data-calculator="pe"><label>{report.valuation.type === 'cycle-pe' ? '週期正常化 EPS' : '正常化 EPS'}<input id="earnings" type="number" step="0.01" value={report.valuation.earnings}/></label><label>合理 P/E<input id="multiple" type="number" step="0.01" value={report.valuation.baseMultiple}/></label><div class="result"><span>試算合理價</span><strong id="result">—</strong></div></div> : <div data-calculator="ev"><label>前瞻營收（百萬）<input id="revenue" type="number" step="1" value={report.valuation.forwardRevenue}/></label><label>EV/Sales<input id="multiple" type="number" step="0.1" value={report.valuation.baseMultiple}/></label><label>情境淨現金（百萬）<input id="cash" type="number" step="1" value={report.valuation.netCash}/></label><label>完全稀釋股數（百萬）<input id="shares" type="number" step="0.1" value={report.valuation.dilutedShares}/></label><div class="result"><span>試算合理價</span><strong id="result">—</strong></div></div>}
        {report.modelNotes && <p class="model-note">{report.modelNotes}</p>}
        <a class="method-link" href={`${base}methodology/${methodFor}`}>查看公式、理論與限制 →</a>
      </div>
      <div class="sources card"><h3>原始來源</h3>{report.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}<span>↗</span></a>)}<p>來源連結不代表網站背書；請以 filing 的原始期間與單位為準。</p></div>
    </aside>
  </section>
  <script>
    const root = document.querySelector('[data-calculator]');
    const result = document.querySelector('#result');
    const inputs = root?.querySelectorAll('input') ?? [];
    function calculate(){
      if(!root || !result) return;
      const v = (id: string) => Number((document.querySelector(`#${id}`) as HTMLInputElement)?.value || 0);
      const kind = root.getAttribute('data-calculator');
      const value = kind === 'pe' ? v('earnings')*v('multiple') : kind === 'future-ebitda' ? (v('ebitda')*v('multiple')+v('cash'))/v('discount')/v('shares') : (v('revenue')*v('multiple')+v('cash'))/v('shares');
      result.textContent = Number.isFinite(value) ? `$${value.toFixed(2)}` : '—';
    }
    inputs.forEach(i=>i.addEventListener('input',calculate)); calculate();
  </script>
  <style>
    .beginner-section{margin-top:34px;padding-top:34px;padding-bottom:8px}.beginner-head{display:flex;align-items:end;justify-content:space-between;gap:24px;padding-bottom:18px;border-bottom:1px solid var(--line)}.beginner-head h2{margin:5px 0 0;font-size:clamp(28px,4vw,42px)}.industry-tag{align-self:center;padding:8px 12px;border:1px solid #9bb9ff;border-radius:999px;background:#f4f7ff;color:#174ea6;font-weight:600;font-size:13px}.beginner-steps{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-top:0;background:white;border-radius:0 0 16px 16px;overflow:hidden}.beginner-steps article{padding:22px 24px;min-height:148px}.beginner-steps article+article{border-left:1px solid var(--line)}.beginner-steps .price-step{background:#edf4ff}.step-label{display:block;margin-bottom:8px;color:var(--blue);font-weight:700;font-size:13px}.beginner-steps p{margin:0;font-size:16px;line-height:1.7}.watch-head{display:flex;justify-content:space-between;align-items:end;gap:32px;margin:38px 0 16px}.watch-head>div>span{color:var(--blue);font-weight:700;font-size:13px}.watch-head h3{margin:4px 0 0;font-size:27px}.watch-head p{max-width:430px;margin:0;color:var(--muted)}.watch-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.watch-card{position:relative;padding:22px;border:1px solid var(--line);border-radius:14px;background:#fff}.watch-card:before{content:'';position:absolute;left:0;top:22px;width:4px;height:34px;border-radius:0 4px 4px 0;background:var(--blue)}.watch-card h3{margin:0 0 7px;font-size:21px}.watch-card>p{min-height:52px;margin:0 0 16px;color:var(--muted)}.signal{display:grid;grid-template-columns:92px 1fr;gap:10px;padding:10px 0;border-top:1px solid var(--line);font-size:14px}.signal b{font-size:12px}.signal span{color:var(--muted)}.signal.good b{color:var(--green)}.signal.bad b{color:var(--red)}.glossary{margin-top:16px;box-shadow:none}.glossary summary{cursor:pointer;padding:17px 20px;color:var(--blue);font-weight:700}.glossary summary:hover{background:var(--blue-soft)}.glossary dl{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin:0;padding:0 20px 20px}.glossary dl>div{display:grid;grid-template-columns:80px 1fr;gap:12px;padding:14px 0;border-top:1px solid var(--line)}.glossary dl>div:nth-child(odd){padding-right:22px}.glossary dl>div:nth-child(even){padding-left:22px;border-left:1px solid var(--line)}.glossary dt{font-weight:700;color:var(--ink)}.glossary dd{margin:0;color:var(--muted);font-size:14px}
    .report-hero{padding:65px 28px 44px;display:grid;grid-template-columns:1fr 290px;gap:50px;align-items:end}.report-hero h1{font-size:clamp(40px,5vw,62px);margin:.2em 0}.report-hero p{font-size:18px;color:var(--muted);max-width:720px}.quote{padding:24px}.quote span,.quote small{display:block;color:var(--muted)}.quote strong{font:600 42px 'IBM Plex Mono';display:block;margin:7px 0}.scenario-strip{display:grid;grid-template-columns:repeat(3,1fr) 1.7fr;border:1px solid var(--line);border-radius:14px;background:white;overflow:hidden}.scenario,.ranges{padding:20px}.scenario+.scenario,.ranges{border-left:1px solid var(--line)}.scenario span,.ranges span{display:block;color:var(--muted);font-size:12px}.scenario strong{font:600 24px 'IBM Plex Mono'}.bear strong{color:var(--red)}.base{background:var(--blue-soft)}.base strong{color:var(--blue)}.bull strong{color:var(--green)}.ranges{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ranges b{font:600 16px 'IBM Plex Mono'}.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:32px;align-items:start}.metric-grid{grid-template-columns:repeat(2,1fr)}.metric-card{padding:18px}.metric-card span,.metric-card small{display:block;color:var(--muted)}.metric-card strong{display:block;font-size:21px;margin:6px 0}.chart{overflow:hidden;margin:24px 0}.chart img{width:100%;display:block}.scenario-table{padding:22px;margin:24px 0}.scenario-table h2{font-size:24px}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;vertical-align:top;padding:12px;border-top:1px solid var(--line)}th{color:var(--muted);font-size:12px}.analysis-list{display:grid;gap:14px;margin:24px 0}.analysis-card{padding:22px}.analysis-card h2{font-size:22px;margin:6px 0}.analysis-card p{margin:0;color:var(--muted)}.split{grid-template-columns:1fr 1fr}.split>div{border-top:3px solid var(--blue);background:#fff;padding:22px}.split>div+div{border-color:var(--red)}li{margin:9px 0}.calc,.sources{padding:22px;margin-bottom:20px}.calc h2{font-size:25px}.calc label{display:block;color:var(--muted);font-size:13px;margin:13px 0}.calc input{display:block;width:100%;margin-top:5px;border:1px solid var(--line);border-radius:8px;padding:10px;background:#f9fafb;font-family:'IBM Plex Mono'}.result{background:#101b2a;color:#fff;border-radius:10px;padding:15px;margin:20px 0}.result span{display:block;color:#9fb0c5;font-size:12px}.result strong{font:600 29px 'IBM Plex Mono'}.model-note{font-size:12px;color:var(--muted)}.method-link{color:var(--blue);font-weight:600}.sources h3{margin-top:0}.sources a{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:12px 0;color:var(--blue);font-size:14px}.sources p{font-size:12px;color:var(--muted)}@media(max-width:850px){.report-hero,.content-grid{grid-template-columns:1fr}.scenario-strip{grid-template-columns:repeat(3,1fr)}.ranges{grid-column:1/4;border-left:0;border-top:1px solid var(--line)}.beginner-steps{grid-template-columns:1fr}.beginner-steps article{min-height:auto}.beginner-steps article+article{border-left:0;border-top:1px solid var(--line)}.watch-head{display:block}.watch-head p{margin-top:8px}.glossary dl{grid-template-columns:1fr}.glossary dl>div:nth-child(odd),.glossary dl>div:nth-child(even){padding-left:0;padding-right:0;border-left:0}}@media(max-width:560px){.scenario-strip{grid-template-columns:1fr}.scenario+.scenario,.ranges{border-left:0;border-top:1px solid var(--line)}.ranges{grid-column:auto}.metric-grid,.split,.watch-grid{grid-template-columns:1fr}.beginner-head{display:block}.industry-tag{display:inline-block;margin-top:12px}.watch-card>p{min-height:auto}.signal{grid-template-columns:1fr;gap:3px}.glossary dl>div{grid-template-columns:1fr;gap:4px}}
  </style>
</Base>
