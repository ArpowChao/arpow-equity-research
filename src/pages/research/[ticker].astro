---
import Signal from "../../components/Signal.astro";
import FilingEvidence from "../../components/FilingEvidence.astro";
import BaseWork from "../../components/BaseWork.astro";
import BuySideBrief from "../../components/BuySideBrief.astro";
import { naturalProse, bilingual, termLabel, gapLabel } from "../../data/learning";
import AnalysisSteps from "../../components/AnalysisSteps.astro";
import ModelSummary from "../../components/ModelSummary.astro";
import { resolveReportViewModel } from "../../lib/report-resolver";
import { calcFcfInclusiveStress } from "../../lib/valuation";
import Base from '../../layouts/Base.astro';
import reports from '../../data/reports.generated.json';
import { beginnerGuides, glossary } from '../../data/beginner-guides';
import type { BeginnerGuide } from '../../data/beginner-guides';

export function getStaticPaths() {
  return reports.map(report => ({ params: { ticker: report.ticker.toLowerCase() }, props: { report } }));
}

type Scenario = { label: string; assumption: string; value: number; condition: string };
type AnalysisBlock = { kicker: string; title: string; body: string };
type ExtendedReport = Omit<(typeof reports)[number], 'valuation'> & {
  valuation: any;
  beginner?: BeginnerGuide;
  dualTrack?: any;
  priceMeta?: { marketState: string; asOf: string; source: string; observedAtUtc?: string };
  scenarios?: Scenario[];
  analysis?: AnalysisBlock[];
  modelNotes?: string;
};

const report = Astro.props.report as ExtendedReport;
const vm = resolveReportViewModel(report);
const dual = vm.dual;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const chartUrl = `${base}${report.chart.replace(/^\//, '')}`;
const priceMeta = report.priceMeta;
const scenarios = report.scenarios ?? [];
const analysis = report.analysis ?? [];
const guide = report.beginner ?? beginnerGuides[report.ticker];

// Precompute FCF-inclusive Track B comparisons for dualTrack reports without erasing legacy ex-FCF columns
const dualCompareRows = (() => {
  if (!vm.dualEconomic || !dual) return [];
  const tIn = dual.tailored.inputs;
  const c10In = dual.common10.inputs;
  const sameAsCommon10 =
    tIn.annualRevenueGrowth === c10In.annualRevenueGrowth &&
    tIn.grossMargin === c10In.grossMargin &&
    tIn.opexRatio === c10In.opexRatio &&
    tIn.terminalPe === c10In.terminalPe;

  const rawRows: Array<[string, any]> = sameAsCommon10
    ? [['公司特性壓力（與統一 10% 對照相同）', dual.tailored], ['零成長對照', dual.zeroGrowth]]
    : [['公司特性壓力', dual.tailored], ['統一10%對照', dual.common10], ['零成長對照', dual.zeroGrowth]];

  return rawRows.map(([label, z]) => {
    const fcfRes = calcFcfInclusiveStress({ ...z.inputs, fcfConversion: 0.85 }, report.snapshot.price, true);
    return { label, legacy: z, fcfRes };
  });
})();
---
<Base title={`${report.ticker}｜${report.company} 個股研究`} description={naturalProse(String(report.thesis))}>
  <section class="shell report-hero">
    <div>
      <div class="eyebrow">{report.ticker} · {vm.historic ? "原研究／歷史模型" : "研究快照"} {report.asOf}</div>
      <h1>{report.company}</h1>
      {!vm.historic && <p>{naturalProse(String(report.thesis))}</p>}
      <FilingEvidence ticker={report.ticker} />
      <a class="link" href="#reading-order">從財報閱讀順序開始 ↓</a>
    </div>
    <div class="quote-column">
      <ModelSummary ticker={report.ticker} />
      {vm.olderModel && vm.activeModel?.kind !== "revalued" && vm.latestFiling && (
        <div class="card" style="padding:16px">
          <strong>估值尚未納入較新申報</strong>
          <p>財報期末：{vm.latestFiling.statement.periodEnd}。下方保留原估值與分析快照，不代表目前合理價。</p>
          <a href={`${base}fundamentals/#${report.ticker.toLowerCase()}`}>查看最新已核對的財報數據 ↗</a>
        </div>
      )}
      {vm.preSplit && vm.split && (
        <div class="card" style="padding:16px">
          <strong>舊模型採拆股前口徑</strong>
          <p>{vm.split.tradingDate} 起按 1 股拆為 {vm.split.ratio} 股交易。原基準換算為每股 ${(report.snapshot.baseFairValue / vm.split.ratio).toFixed(2)}，僅換算單位，不是重新估值。舊圖表、快照與試算仍採原口徑。</p>
          <a href={vm.split.source}>SEC 拆股文件 ↗</a>
        </div>
      )}
      <div class="live-quote card" data-live-quote data-min-observed-at={priceMeta?.observedAtUtc} data-ticker={report.ticker} data-endpoint={`${base}data/live-quotes.json`} aria-live="polite">
        <div class="quote-heading"><span>最新可得行情</span><b data-live-status>讀取中</b></div>
        <strong data-live-price>—</strong>
        <small data-live-change>正在取得最新行情…</small>
        <small data-live-time></small>
        <small class="quote-disclaimer">以實際成交時間為準 · 非交易所即時報價</small>
      </div>
      <div class="snapshot-quote card">
        <span>{vm.historic ? '歷史模型｜原分析股價' : vm.isAudit ? '本篇分析快照（原模型；稽核保留）' : '本篇分析快照'}</span>
        <strong>${report.snapshot.price.toFixed(2)}</strong>
        <small>{vm.detailBaseLabel} ${report.snapshot.baseFairValue.toFixed(2)} · {gapLabel} <Signal value={vm.originalGap} kind="gap" /></small>
        {priceMeta && <small>{priceMeta.asOf} · 固定不變</small>}
      </div>
    </div>
  </section>

  <section class="shell scenario-strip">
    <div class="scenario bear"><span>悲觀</span><strong>${report.snapshot.bear.toFixed(2)}</strong></div>
    <div class="scenario base"><span>{vm.scenarioBaseLabel}</span><strong>${report.snapshot.base.toFixed(2)}</strong></div>
    <div class="scenario bull"><span>樂觀</span><strong>${report.snapshot.bull.toFixed(2)}</strong></div>
    <div class="ranges">
      <div><span>{vm.fairRangeLabel}</span><b>${report.snapshot.fairRange[0]}–${report.snapshot.fairRange[1]}</b></div>
      <div><span>{vm.mosLabel}</span><b>${report.snapshot.marginOfSafety[0]}–${report.snapshot.marginOfSafety[1]}</b></div>
    </div>
  </section>

  <BuySideBrief ticker={report.ticker} />

  <div class="shell" id="reading-order">
    <AnalysisSteps compact />
    <p><a class="link" href="#company-evidence">看這家公司的營運證據 ↓</a> · <a class="link" href={`${base}fundamentals/#${report.ticker.toLowerCase()}`}>用這家公司的申報數字練習 ↗</a> · <a class="link" href="#filing-sources">找原始申報 ↓</a></p>
  </div>
  {vm.historic && <div class="shell"><h2>歷史模型｜以下數字僅供版本回顧</h2><p><b>{report.asOf} 原研究摘要：</b>{naturalProse(report.thesis)}</p></div>}

  <div class="shell"><p style="margin:17px 0 0;padding:11px 15px;background:#edf4ff;border-left:4px solid #2762be;line-height:1.6">這份估值與投資判斷固定於 {report.asOf}；<a href={vm.conditionalModel ? '#filing-sources' : `${base}fundamentals/#${report.ticker.toLowerCase()}`}>{vm.sourceLinkLabel}</a>。新文件與行情不會自動重算合理價。</p></div>

  {guide && <section class="shell beginner-section" aria-labelledby="beginner-title">
    <div class="beginner-head">
      <div><div class="eyebrow">從這裡開始</div><h2 id="beginner-title">第一次看這家公司，先看這裡</h2></div>
      <span class="industry-tag">{guide.industry}</span>
    </div>
    <div class="beginner-steps">
      <article><span class="step-label">它怎麼賺錢？</span><p>{naturalProse(String(guide.earns))}</p></article>
      <article><span class="step-label">現在真正要問什麼？</span><p>{naturalProse(String(guide.keyQuestion))}</p></article>
      <article class="price-step"><span class="step-label">價格怎麼看？</span><p>{vm.historic ? `下列估值固定於 ${report.asOf}，不是現時判斷。請先核對新財報，再看頁首條件試算（如有）。` : vm.priceVerdict}</p></article>
    </div>
    <div class="watch-head"><div><span>不同產業，看不同數字</span><h3>這家公司最該追蹤的業務引擎</h3></div><p>不用一次看懂所有財報。先盯這幾項，確認它們是在變好，還是變壞。</p></div>
    <div class="watch-grid">{guide.watch.map(item=><article class="watch-card">
      <h3>{naturalProse(String(item.name))}</h3><p>{naturalProse(String(item.why))}</p>
      <div class="signal good"><b>變好看這個</b><span>{naturalProse(String(item.good))}</span></div>
      <div class="signal bad"><b>警訊看這個</b><span>{naturalProse(String(item.warning))}</span></div>
    </article>)}</div>
    <details class="glossary card"><summary>點開白話名詞表：會計口徑、現金流與合約</summary><dl>{guide.terms.map(term=><div><dt>{termLabel(term)}</dt><dd>{naturalProse(glossary[term] ?? "") }</dd></div>)}</dl></details>
  </section>}

  <section class="shell content-grid section">
    <article class="lulu-research">
      <div class="section-head" id="company-evidence"><div><div class="eyebrow">營運證據</div><h2>關鍵營運證據</h2></div></div>
      <div class="metric-grid grid">{report.metrics.map(m=><div class="metric-card card"><span>{bilingual(String(m.label))}</span><strong>{naturalProse(String(m.value))}</strong><small>{naturalProse(String(m.note))}</small></div>)}</div>
      <div class="chart card"><img src={chartUrl} alt={`${report.ticker} 於 ${report.asOf} 的${vm.dualEconomic ? '行情與雙軌估值圖' : '一年價格結構圖'}`} loading="lazy" /></div>
      {scenarios.length > 0 && <div class="scenario-table card"><h2>情境假設與驗證條件</h2><div class="table-scroll"><table><thead><tr><th>情境</th><th>核心輸入</th><th>{vm.conditionalModel ? '條件式價值' : '合理價'}</th><th>可觀察條件</th></tr></thead><tbody>{scenarios.map(s=><tr><td><b>{s.label}</b></td><td>{naturalProse(String(s.assumption))}</td><td class="mono">${Number(s.value).toFixed(2)}</td><td>{naturalProse(String(s.condition))}</td></tr>)}</tbody></table></div></div>}
      {vm.dualEconomic && <section class="dual-track card" id="value-stock-stress">
        <div class="eyebrow">Track B v2 · Value-stock stress（含期間 FCF 現值修正）</div>
        <h2>退化成價值股，現在還值得嗎？</h2>
        <p>這是獨立於 NTM 三情境的四年壓力測試。<b>v2 已修正舊版漏算 4 年自由現金流折現的缺陷</b>（預設保守 FCF 轉化率 85%），同時保留舊版僅計終值作為對照，並在下方試算器提供即時 3×3 營收×毛利二維矩陣。</p>
        <p><b>起點 TTM 收入：</b>{dual.tailored.inputs.seedRevenueM.toLocaleString('en-US')} 百萬美元。<b>固定壓力假設：</b>毛利率 {(dual.tailored.inputs.grossMargin*100).toFixed(1)}%、費用率 {(dual.tailored.inputs.opexRatio*100).toFixed(1)}%、淨其他 {dual.tailored.inputs.netOtherM} 百萬、稅率 {(dual.tailored.inputs.taxRate*100).toFixed(1)}%、年稀釋 {(dual.tailored.inputs.annualDilution*100).toFixed(1)}%。</p>
        <div class="table-scroll"><table><thead><tr><th>年度</th><th>營收</th><th>毛利</th><th>費用</th><th>稅後淨利</th><th>EPS</th></tr></thead><tbody>{dual.tailored.years.map((y: any)=><tr><td>第{y.year}年</td><td>{y.revenueM.toFixed(0)}</td><td>{y.grossProfitM.toFixed(0)}</td><td>{y.opexM.toFixed(0)}</td><td>{y.netIncomeM.toFixed(0)}</td><td>${y.eps.toFixed(2)}</td></tr>)}</tbody></table></div>
        <small>金額：百萬美元；EPS：美元／股。自研究日起近似四年，非公司逐季指引。</small>
        <div class="table-scroll"><table><thead><tr><th>同成本下的收入成長</th><th>末期價值</th><th>折現現值（舊版不含FCF）</th><th>含4年FCF總現值(85%)</th><th>含FCF年化報酬</th></tr></thead><tbody>{dualCompareRows.map((row)=><tr><td>{row.label}（{(row.legacy.inputs.annualRevenueGrowth*100).toFixed(0)}%）</td><td>${row.legacy.terminalValue.toFixed(2)}</td><td>${row.legacy.presentValue.toFixed(2)}</td><td class="mono"><b>${row.fcfRes.presentValue.toFixed(2)}</b></td><td>{row.fcfRes.annualReturnTotal===null?'不適用':`${(row.fcfRes.annualReturnTotal*100).toFixed(1)}%`}</td></tr>)}</tbody></table></div>
        <p>末期 {dual.tailored.inputs.terminalPe} 倍、要求報酬 {(dual.tailored.inputs.discountRate*100).toFixed(0)}%、期間 {dual.tailored.inputs.years} 年。v2 總現值＝四年各期 FCF 折現 ＋ 第四年終值折現。</p>
        <div class="stress-calc" data-stress-calculator data-stress-inputs={JSON.stringify({ ...dual.tailored.inputs, fcfConversion: 0.85 })} data-price={report.snapshot.price}>
          <h3>自己改假設，同步看含 FCF 現值與 3×3 雙殺矩陣</h3>
          <div class="stress-inputs">
            <label>起點營收（百萬美元）<input data-stress-seed type="number" step="1000" value={dual.tailored.inputs.seedRevenueM}/></label>
            <label>年營收成長（%）<input data-stress-growth type="number" step="1" value={dual.tailored.inputs.annualRevenueGrowth*100}/></label>
            <label>毛利率（%）<input data-stress-margin type="number" step="1" value={dual.tailored.inputs.grossMargin*100}/></label>
            <label>FCF 轉化率（%）<input data-stress-conv type="number" step="5" min="0" max="120" value="85"/></label>
            <label>末期 P/E<input data-stress-pe type="number" step="1" value={dual.tailored.inputs.terminalPe}/></label>
            <label>要求報酬率（%）<input data-stress-discount type="number" step="1" value={dual.tailored.inputs.discountRate*100}/></label>
          </div>
          <p class="stress-results">
            末期終值 <b data-stress-terminal>—</b>（僅終值現值 <b data-stress-pv-legacy>—</b>）<br/>
            ＋ 4 年期間 FCF 現值 <b data-stress-pv-fcf>—</b> ＝ <b>含權總現值 <b data-stress-pv>—</b></b> ／ 含現金流年化 <b data-stress-annual>—</b>
          </p>
          <div class="table-scroll">
            <table class="mini-matrix">
              <thead><tr><th>動態 3×3（成長 ＼ 毛利）</th><th data-mx-col0>—</th><th data-mx-col1>—</th><th data-mx-col2>—</th></tr></thead>
              <tbody data-mx-body></tbody>
            </table>
          </div>
        </div>
        <a class="method-link" href={`${base}methodology/${vm.methodSlug}`}>原雙軌公式與限制 →</a> · <a class="method-link" href={`${base}methodology/buyside-v2-playbook`}>v2 FCF 修正說明 →</a><br/><a class="method-link" href={`${base}comparisons/six-2026-11-14/`}>回到六股雙軌比較 →</a>
      </section>}
      {analysis.length > 0 && <div class="analysis-list">{analysis.map(a=><section class="analysis-card card"><div class="eyebrow">{a.kicker}</div><h2>{a.title}</h2><p>{a.body}</p></section>)}</div>}
      <div class="split grid"><div><h2>價值驅動因子</h2><ul>{report.drivers.map(x=><li>{x}</li>)}</ul></div><div><h2>主要風險</h2><ul>{report.risks.map(x=><li>{x}</li>)}</ul></div></div>
    </article>
    <aside>
      <div class="calc card">
        <div class="eyebrow">估值計算</div><h2>{vm.historic ? "歷史模型估值試算" : "估值試算"}</h2>{!vm.activeModel && <BaseWork ticker={report.ticker} legacy={report} />}
        {report.valuation.type === 'future-ev-ebitda' ? <div data-calculator="future-ebitda"><label>Forward EBITDA（遠期息稅折舊攤銷前盈餘，百萬美元）<input id="ebitda" type="number" step="10" value={report.valuation.forwardEbitda}/></label><label>EV/EBITDA（企業價值／息稅折舊攤銷前盈餘，倍）<input id="multiple" type="number" step="0.5" value={report.valuation.baseMultiple}/></label><label>Forward Net Cash（遠期淨現金，百萬美元；淨負債填負值）<input id="cash" type="number" step="10" value={report.valuation.netCash}/></label><label>Discount Factor（折現係數）<input id="discount" type="number" step="0.01" value={report.valuation.discountFactor}/></label><label>未來稀釋股數（百萬）<input id="shares" type="number" step="1" value={report.valuation.dilutedShares}/></label><div class="result"><span>試算現值</span><strong id="result">—</strong></div></div> : report.valuation.type !== 'ev-sales-diluted' ? <div data-calculator="pe"><label>{vm.calcFieldLabel}<input id="earnings" type="number" step="0.01" value={report.valuation.earnings}/></label><label>{vm.conditionalModel ? '條件式本益比' : '假設本益比'}<input id="multiple" type="number" step="0.01" value={report.valuation.baseMultiple}/></label><div class="result"><span>{vm.conditionalModel ? '試算條件式價值' : '試算合理價'}</span><strong id="result">—</strong></div></div> : <div data-calculator="ev"><label>Forward Revenue（預估營收，百萬美元）<input id="revenue" type="number" step="1" value={report.valuation.forwardRevenue}/></label><label>EV/Revenue（企業價值／營收，倍）<input id="multiple" type="number" step="0.1" value={report.valuation.baseMultiple}/></label><label>{report.ticker === 'INTC' ? '情境淨資產調整（百萬美元；含非控制權益）' : '情境淨現金（百萬）'}<input id="cash" type="number" step="1" value={report.valuation.netCash}/></label><label>Fully Diluted Shares（完全稀釋股數，百萬股）<input id="shares" type="number" step="0.1" value={report.valuation.dilutedShares}/></label><div class="result"><span>{vm.conditionalModel ? '試算條件式價值' : '試算合理價'}</span><strong id="result">—</strong></div></div>}
        {report.modelNotes && <p class="model-note">{naturalProse(String(report.modelNotes))}</p>}
        <a class="method-link" href={`${base}methodology/${vm.methodSlug}`}>查看公式、理論與限制 →</a>
      </div>
      <div class="sources card" id="filing-sources"><h3>原始來源</h3>{report.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}<span>↗</span></a>)}<p>來源連結不代表網站背書；請以 filing 的原始期間與單位為準。</p></div>
    </aside>
  </section>
  <script>
    import { calcFcfInclusiveStress } from '../../lib/valuation';

    const root = document.querySelector('[data-calculator]');
    const result = document.querySelector('#result');
    const inputs = root?.querySelectorAll('input') ?? [];
    function calculate(){
      if(!root || !result) return;
      const v = (id: string) => Number((document.querySelector(`#${id}`) as HTMLInputElement)?.value || 0);
      const kind = root.getAttribute('data-calculator');
      const value = kind === 'pe' ? v('earnings')*v('multiple') : kind === 'future-ebitda' ? (v('ebitda')*v('multiple')+v('cash'))/v('discount')/v('shares') : (v('revenue')*v('multiple')+v('cash'))/v('shares');
      result.textContent = Number.isFinite(value) ? `$${value.toFixed(2)}` : '—';
    }
    inputs.forEach(i=>i.addEventListener('input',calculate)); calculate();

    const stressRoot = document.querySelector<HTMLElement>('[data-stress-calculator]');
    function calculateStress(){
      if(!stressRoot) return;
      const base=JSON.parse(stressRoot.dataset.stressInputs || '{}');
      const price = Number(stressRoot.dataset.price || 0);
      const v=(selector:string)=>Number(stressRoot.querySelector<HTMLInputElement>(selector)?.value);
      const seed=v('[data-stress-seed]'), g=v('[data-stress-growth]')/100, gm=v('[data-stress-margin]')/100, conv=v('[data-stress-conv]')/100, pe=v('[data-stress-pe]'), dr=v('[data-stress-discount]')/100;
      const valid=[seed,g,gm,conv,pe,dr].every(Number.isFinite)&&seed>0&&g>-1&&gm>=0&&gm<=1&&conv>=0&&conv<=1.5&&pe>0&&dr>-1;
      const set=(s:string,text:string)=>{const n=stressRoot.querySelector(s);if(n)n.textContent=text;};
      if(!valid){
        ['[data-stress-terminal]','[data-stress-pv-legacy]','[data-stress-pv-fcf]','[data-stress-pv]','[data-stress-annual]'].forEach(s=>set(s,'不適用'));
        return;
      }
      const runInput = { ...base, seedRevenueM: seed, annualRevenueGrowth: g, grossMargin: gm, fcfConversion: conv, terminalPe: pe, discountRate: dr };
      const res = calcFcfInclusiveStress(runInput, price, true);
      set('[data-stress-terminal]', res.terminalValue >= 0 ? `$${res.terminalValue.toFixed(2)}` : '不適用');
      set('[data-stress-pv-legacy]', res.pvTerminal >= 0 ? `$${res.pvTerminal.toFixed(2)}` : '不適用');
      set('[data-stress-pv-fcf]', `$${res.pvInterimFcf.toFixed(2)}`);
      set('[data-stress-pv]', res.presentValue >= 0 ? `$${res.presentValue.toFixed(2)}` : '不適用');
      set('[data-stress-annual]', res.annualReturnTotal != null && Number.isFinite(res.annualReturnTotal) ? `${(res.annualReturnTotal*100).toFixed(1)}%` : '不適用');

      const gList = [g - 0.05, g, g + 0.05].map(x => Math.max(-0.5, x));
      const mList = [Math.max(0.05, gm - 0.05), gm, Math.min(0.95, gm + 0.05)];
      mList.forEach((mVal, idx) => set(`[data-mx-col${idx}]`, `${(mVal*100).toFixed(1)}% 毛利`));
      const tbody = stressRoot.querySelector('[data-mx-body]');
      if(tbody){
        tbody.innerHTML = gList.map(gVal => {
          const cells = mList.map(mVal => {
            const cellRes = calcFcfInclusiveStress({ ...runInput, annualRevenueGrowth: gVal, grossMargin: mVal }, price, true);
            const gap = cellRes.gapPctVsPrice != null ? `${cellRes.gapPctVsPrice > 0 ? '+' : ''}${(cellRes.gapPctVsPrice*100).toFixed(1)}%` : '—';
            return `<td><b>$${cellRes.presentValue.toFixed(2)}</b> <small>(${gap})</small></td>`;
          }).join('');
          return `<tr><th>年增 ${(gVal*100).toFixed(0)}%</th>${cells}</tr>`;
        }).join('');
      }
    }
    stressRoot?.querySelectorAll('input').forEach(i=>i.addEventListener('input',calculateStress));calculateStress();

    const liveCard = document.querySelector<HTMLElement>('[data-live-quote]');
    const phaseLabels: Record<string,string> = {'pre-market':'盤前','regular':'正規盤','post-market':'盤後','closed':'收盤'};
    async function refreshLiveQuote(){
      if(!liveCard) return;
      const endpoint = liveCard.dataset.endpoint;
      const ticker = liveCard.dataset.ticker;
      const status = liveCard.querySelector<HTMLElement>('[data-live-status]');
      const price = liveCard.querySelector<HTMLElement>('[data-live-price]');
      const change = liveCard.querySelector<HTMLElement>('[data-live-change]');
      const time = liveCard.querySelector<HTMLElement>('[data-live-time]');
      if(!endpoint || !ticker || !status || !price || !change || !time) return;
      try{
        const response = await fetch(`${endpoint}?v=${Date.now()}`, {cache:'no-store'});
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        const quote = payload?.quotes?.[ticker];
        if(!quote || !Number.isFinite(Number(quote.price))) throw new Error('quote unavailable');
        const minimum=Date.parse(liveCard.dataset.minObservedAt||'');
        const observedAt=Date.parse(quote.observedAt||'');
        if(Number.isFinite(minimum)&&(!Number.isFinite(observedAt)||observedAt<minimum)) throw new Error('stale quote');
        const current = Number(quote.price);
        const delta = Number(quote.change);
        const percent = Number(quote.changePercent);
        status.textContent = phaseLabels[quote.phase] ?? '最新成交';
        price.textContent = `$${current.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
        change.textContent = `${delta>=0?'+':''}${delta.toFixed(2)}（${percent>=0?'+':''}${percent.toFixed(2)}%）· 相對${quote.phase==='regular'?'前收':'正規盤收盤'}`;
        change.classList.remove('positive','negative');
        change.classList.add(delta>=0?'positive':'negative');
        const observed = new Date(quote.observedAt).toLocaleString('zh-TW',{timeZone:quote.exchangeTimezone||'America/New_York',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false});
        const fetched = new Date(payload.fetchedAt).toLocaleString('zh-TW',{timeZone:quote.exchangeTimezone||'America/New_York',hour:'2-digit',minute:'2-digit',hour12:false});
        time.textContent = `行情 ${observed} · 資料更新 ${fetched}（美東）`;
        liveCard.dataset.state = 'ready';
      }catch(error){
        const stale=error instanceof Error && error.message==='stale quote';
        status.textContent = stale ? '暫無較新行情' : '暫時無法更新';
        price.textContent = '—';
        change.textContent = stale ? '行情檔早於分析快照，已隱藏舊價格；請看下方時間。' : '行情服務目前沒有可用資料；請以下方分析快照為準。';
        time.textContent = '';
        liveCard.dataset.state = 'error';
      }
    }
    refreshLiveQuote();
    window.setInterval(refreshLiveQuote, 60_000);
    document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='visible') refreshLiveQuote(); });
  </script>
