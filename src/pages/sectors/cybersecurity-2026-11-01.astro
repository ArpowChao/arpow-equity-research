---
import Base from '../../layouts/Base.astro';
import report from '../../data/cybersecurity-2026-11-01.json';
const sourceById = new Map(report.sources.map(s => [s.id, s]));
const groups = ['大型', '中型', '小型'];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const lanes = [
  {title:'AI應用與Agent防護', description:'檢查AI使用、提示與工具存取；產品存在不等於已產生大量AI收入。', tickers:'PANW · ZS · S · NET'},
  {title:'SOC與攻擊面管理', description:'協助分析告警、找出弱點與修補風險；看平台採用與付費擴張。', tickers:'CRWD · S · TENB · QLYS · RPD'},
  {title:'資料韌性與復原', description:'攻擊、資料破壞或Agent操作出錯後，能否安全恢復業務。', tickers:'RBRK'},
  {title:'網路與API基礎設施', description:'防火牆、SASE、DDoS與應用入口防護，留意產品與訂閱循環。', tickers:'FTNT · ATEN · NET'},
];
---
<Base title="美股資安與AI安全｜大中小盤觀察名單" description="以官方財報與產品資料整理11家美股資安觀察公司，區分AI安全、獲利品質、轉機風險及併購狀態。不是買入或合理價清單。">
  <div class="shell sector">
    <header class="intro">
      <div class="eyebrow">Sector field notes / 2026-11-01</div>
      <h1>資安的下一筆預算，<br/>會流向誰？</h1>
      <p class="lead">美股資安與AI安全觀察名單：先看公司解決什麼問題，再看成長能否變成股東的現金流。</p>
      <div class="summary"><span><b>{report.companies.length}</b> 家候選</span><span><b>{report.counts['大型']} / {report.counts['中型']} / {report.counts['小型']}</b> 大／中／小盤</span><span><b>10/30</b> 正規盤行情快照</span></div>
      <p class="caution"><strong>產業初篩，不是買入清單。</strong>本頁未建立三情境合理價；成長潛力不代表目前價格有安全邊際。財報版本逐股列明，並非所有公司都已公布第三季。</p>
    </header>

    <section class="block" aria-labelledby="thesis">
      <div class="eyebrow">Investment question</div><h2 id="thesis">不是「有AI」，而是「誰會付錢」</h2>
      <p>{report.thesis}</p>
      <p><strong>以AI做資安</strong>：協助分析、偵測與回應攻擊。<strong>保護AI</strong>：保護模型、應用、資料與Agent工具存取。兩者可以重疊，但不能把通用聊天助理當成已驗證的AI安全收入。</p>
      <div class="laneGrid">{lanes.map(l => <article class="lane"><h3>{l.title}</h3><p>{l.description}</p><strong class="mono">{l.tickers}</strong></article>)}</div>
    </section>

    <aside class="eventNotice block" aria-labelledby="actions"><h2 id="actions">先排除過時的股票名單</h2>
      {report.corporateActions.map(a => <p><strong>{a.ticker}｜{a.status}</strong><br/>{a.detail} <a href={sourceById.get(a.source)?.url} target="_blank" rel="noopener noreferrer">官方公告 [{a.source}] ↗</a></p>)}
    </aside>

    <section class="block" aria-labelledby="list">
      <div class="section-head"><div><div class="eyebrow">Research universe</div><h2 id="list">按規模與風險分層，不按股價高低</h2></div></div>
      <p class="muted">分類口徑：大型≥100億美元；中型≥20億且&lt;100億美元；小型&lt;20億美元。市值為分類用約數，不是同時點精確估值輸入。{report.marketCapMethod}</p>
      <div class="filters" aria-label="依市值篩選"><button type="button" data-size="全部" aria-pressed="true">全部</button>{groups.map(g => <button type="button" data-size={g} aria-pressed="false">{g} · {report.counts[g as keyof typeof report.counts]}</button>)}</div>
      <p id="filter-status" class="muted" aria-live="polite">顯示 {report.companies.length} 家公司</p>
      <div class="companyGrid">
      {report.companies.map(c => <article class="company card" data-company data-size={c.size} id={c.ticker.toLowerCase()}>
        <div class="companyHead"><div><strong class="ticker mono">{c.ticker}</strong><h3>{c.company}</h3></div><span class="pill">{c.size}</span></div>
        <div class="scale">約 <b>{c.marketCapYiUsdApprox.toLocaleString('zh-TW')}</b> 億美元市值 <a href={sourceById.get(c.marketCapSource)?.url} target="_blank" rel="noopener noreferrer" aria-label={`${c.ticker}市值來源`}>[{c.marketCapSource}]</a></div>
        <p class="laneLabel">{c.lane}</p><p class="priority">研究定位：{c.priority}</p>
        <p class="thesis">{c.thesis}</p>
        <dl>
          <div><dt>財報版本</dt><dd>{c.period}{c.scheduleSource && <> <a href={sourceById.get(c.scheduleSource)?.url} target="_blank" rel="noopener noreferrer">官方排程 [{c.scheduleSource}] ↗</a></>}</dd></div>
          <div><dt>成長證據</dt><dd>{c.growth}</dd></div>
          <div><dt>獲利／現金品質</dt><dd>{c.quality}</dd></div>
          <div><dt>AI曝險</dt><dd>{c.ai}</dd></div>
          <div><dt>主要風險</dt><dd>{c.risk}</dd></div>
          <div><dt>下一個驗證訊號</dt><dd>{c.watch}</dd></div>
        </dl>
        <div class="cardLinks"><a href={sourceById.get(c.financialSource)?.url} target="_blank" rel="noopener noreferrer">官方財報 [{c.financialSource}] ↗</a><a href={sourceById.get(c.productSource)?.url} target="_blank" rel="noopener noreferrer">產品／策略 [{c.productSource}] ↗</a></div>
        <details><summary>行情快照與核對範圍</summary><p>股價 ${c.priceSnapshotUsd.toFixed(2)}，時間 {c.priceSnapshotTime}；此價格不代表買點。<a href={c.quoteSource} target="_blank" rel="noopener noreferrer">行情資料 ↗</a></p><p>{c.financialAccess}。{c.valuationStatus}。</p></details>
      </article>)}
      </div>
    </section>

    <section class="block" aria-labelledby="discipline"><div class="eyebrow">Decision discipline</div><h2 id="discipline">先驗證商業化，再談合理價</h2>
      <ol class="checklist"><li><strong>誰在付錢？</strong>區分付費客戶、免費試用、概念驗證與一般產品公告。</li><li><strong>成長從哪裡來？</strong>PANW與ZS要拆併購，SaaS轉換不能一律當新客成長。</li><li><strong>現金是否屬於股東？</strong>比較GAAP、FCF與SBC稀釋，不只看調整後利潤。</li><li><strong>股價要求多高？</strong>用同時點股數、淨負債與未來情境再估值；本頁不把成長名單包裝成便宜名單。</li></ol>
      <p class="caution">小型股不等於便宜：ATEN屬於網路與應用防護的間接受益；RPD則是營收仍衰退的轉機觀察，兩者不能用同一個「AI高成長」標籤。</p>
    </section>

    <section class="block" aria-labelledby="glossary"><h2 id="glossary">看懂名詞</h2><div class="glossary">{report.glossary.map(([term, meaning]) => <details><summary>{term}</summary><p>{meaning}</p></details>)}</div></section>
    <section class="block sources" aria-labelledby="sources"><h2 id="sources">來源與查證限制</h2><p>{report.limitations}</p><p>資料截止：{report.asOf}；行情快照：{report.quoteDate}。產品與收購公告依各來源原文日期。原始擷取、失敗紀錄與底稿留在私有研究庫，公開頁只輸出白名單欄位。</p><ul>{report.sources.map(s => <li id={`source-${s.id}`}><a href={s.url} target="_blank" rel="noopener noreferrer">[{s.id}] {s.title}</a><small>擷取日期 {s.accessed}</small></li>)}</ul><a class="link" href={base}>返回研究首頁 →</a></section>
  </div>
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-size][type="button"]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-company]'));
    const status = document.querySelector<HTMLElement>('#filter-status');
    buttons.forEach(button => button.addEventListener('click', () => {
      const size = button.dataset.size;
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach(card => {card.hidden = size !== '全部' && card.dataset.size !== size;});
      if(status) status.textContent = `顯示 ${cards.filter(c => !c.hidden).length} 家公司`;
    }));
  </script>
  <style>
    .sector{padding-top:52px;padding-bottom:40px}.intro{max-width:930px}.intro h1{font-size:clamp(38px,5.5vw,66px)}.lead{font-size:21px;color:var(--muted);max-width:820px}.summary{display:flex;gap:32px;flex-wrap:wrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0;margin:26px 0}.summary span{color:var(--muted)}.summary b{display:block;color:var(--ink);font-size:26px}.caution{background:var(--blue-soft);padding:20px 22px;border-radius:10px}.block{margin-top:48px}.block>p{max-width:940px}.laneGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:24px}.lane{padding:22px;background:var(--surface);border:1px solid var(--line);border-radius:12px}.lane h3{margin-top:0}.lane p{color:var(--muted)}.lane strong{font-size:14px;color:var(--blue)}.eventNotice{padding:25px;background:#fff7e8;border:1px solid #eadac2;border-radius:12px}.eventNotice h2{font-size:25px}.eventNotice p{margin-bottom:0}.eventNotice a,.scale a,.cardLinks a,.sources a,details a{color:var(--blue);text-underline-offset:3px}.filters{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.filters button{min-height:44px;padding:9px 18px;background:var(--surface);border:1px solid var(--line);border-radius:7px;cursor:pointer;color:var(--ink)}.filters button[aria-pressed='true']{background:var(--blue);color:white;border-color:var(--blue)}.filters button:hover{box-shadow:0 3px 10px #15202b14}.companyGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.company{padding:25px;min-width:0}.company[hidden]{display:none}.companyHead{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.ticker{font-size:27px}.company h3{font-size:22px;margin:7px 0 12px}.scale{font-size:15px;color:var(--muted)}.scale b{color:var(--ink)}.laneLabel{color:var(--muted);font-size:15px;margin-bottom:7px}.priority{color:var(--blue);font-weight:600;margin-top:0}.thesis{font-size:17px;padding-bottom:16px;border-bottom:1px solid var(--line)}dl{margin:0}dl>div{margin:16px 0}dt{font-size:13px;font-weight:700;letter-spacing:.03em;color:var(--muted)}dd{margin:4px 0 0;font-size:16px}.cardLinks{display:flex;flex-wrap:wrap;gap:16px;font-size:14px;padding:12px 0}details{border-top:1px solid var(--line);padding:13px 0}summary{cursor:pointer;font-weight:600}details p{font-size:14px;color:var(--muted);overflow-wrap:anywhere}.glossary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 30px}.checklist{padding-left:24px}.checklist li{margin:14px 0}.sources li{margin:13px 0;overflow-wrap:anywhere}.sources small{display:block;color:var(--muted)}@media(max-width:720px){.sector{padding-top:34px}.lead{font-size:18px}.summary{gap:18px}.summary span{font-size:13px}.summary b{font-size:22px}.laneGrid,.companyGrid,.glossary{grid-template-columns:1fr}.company{padding:21px}.eventNotice{padding:20px}.block{margin-top:36px}}
  </style>
</Base>
